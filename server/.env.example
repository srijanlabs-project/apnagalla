# Copy to server/.env for local development.

# Leave empty to use an embedded Postgres (PGlite) stored in server/.data/pglite.
# On Railway this is set automatically from the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

PORT=3000

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=dev-only-change-me-dev-only-change-me

# Comma-separated list of extra browser origins allowed to call the API (web app URL).
# Capacitor Android (https://localhost) and Vite dev (http://localhost:5173) are always allowed.
CORS_ORIGINS=

# OTP delivery: "console" (prints the code in server logs) or "msg91".
OTP_PROVIDER=console
# Dev convenience: when set (and NODE_ENV is not production) every OTP is this code.
OTP_FIXED_CODE=123456
# Required to run console OTP when NODE_ENV=production (e.g. staging before DLT approval).
ALLOW_CONSOLE_OTP=false

# MSG91 (needs TRAI DLT-approved OTP template)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
